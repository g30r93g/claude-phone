; LAN only. Every endpoint needs the IPv4 RTP binding or audio fails one way on macOS (docs/build-notes.md fix 9).
[global]
type=global
user_agent=claude-phone

[udp]
type=transport
protocol=udp
bind=@@LAN_IP@@:5060

[acl]
type=acl
deny=0.0.0.0/0
permit=@@LAN_CIDR@@

[desk-endpoint](!)
type=endpoint
context=from-desk
disallow=all
allow=g722,ulaw,alaw
direct_media=no
media_address=@@LAN_IP@@
bind_rtp_to_media_address=yes
rtp_ipv6=no
mailboxes=owner@claude
send_pai=yes
trust_id_outbound=yes

[desk-aor](!)
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=10
qualify_timeout=2

; T31P
[@@DESK_EXT@@](desk-endpoint)
auth=@@DESK_EXT@@-auth
aors=@@DESK_EXT@@
[@@DESK_EXT@@-auth]
type=auth
auth_type=userpass
username=@@DESK_EXT@@
password=@@SIP_PASSWORD@@
[@@DESK_EXT@@](desk-aor)

; Linphone (testing)
[@@SOFT_EXT@@](desk-endpoint)
auth=@@SOFT_EXT@@-auth
aors=@@SOFT_EXT@@
[@@SOFT_EXT@@-auth]
type=auth
auth_type=userpass
username=@@SOFT_EXT@@
password=@@SIP_PASSWORD@@
[@@SOFT_EXT@@](desk-aor)
